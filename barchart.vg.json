{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text":"Diseases caused by Smoking",
        "fontSize": 20
    },
    "width":900,
    "height":450,
    "data": 
    {
        "url": "https://raw.githubusercontent.com/IlyasHasyim/FIT3179_Vis2_Repository/refs/heads/main/data/Dataset.csv"
    },
    "transform": [
        {"filter": "datum.State != 'Australia'"},
        {
            "fold": [
                "Cancer", "COPD", "Heart, Stroke and Vascular Disease"
            ],
            "as": ["Diseases", "Number of Cases"]
        }
    ],

    "params": [
        {
            "name": "caseFilter",
            "value":0,
            
            "bind":{
                "input": "range",
                "min": 0,
                "max": 400,
                "name": "Filter by Number of Cases: "
            }
        }
    ],
    "autosize":"fit",
    "layer": [
        {
            "mark":"bar",
            "encoding": {
                "x": {
                    "field": "Short Name",
                    "type": "nominal",
                    "title": "State",
                    "axis": {
                        "labelAngle":0,
                        "labelFontSize":13,
                        "titleFontSize":15
                    }
                },
                "xOffset":{"field": "Diseases"},
                "y": {
                    "field": "Number of Cases",
                    "type": "quantitative",
                    "title": "Number of Cases",
                    "axis":{
                        "labelFontSize":13,
                        "titleFontSize":15
                    }
                },
                "color":{
                    "field": "Diseases",
                    "type": "nominal",
                    "scale":{"scheme":"reds"},
                    "legend":{
                        "titleFontSize":15,
                        "labelFontSize":10,
                        "orient": "right"
                    },
                    "condition":{
                        "test":"datum['Number of Cases'] < caseFilter",
                        "value": "lightgrey"
                    }          
                },
                "opacity":{
                    "condition":{
                        "test":"datum['Number of Cases'] >= caseFilter",
                        "value":1
                    },
                    "value":0.5
                    
                },
                "tooltip":[
                    {"field":"State"},
                    {"field":"Diseases"},
                    {"field":"Number of Cases"}
                ]
            }
        },
        {
            "mark":{"type": "text","color":"grey", "fontSize": 15, "fontWeight":"lighter"},
            "encoding": {
                "x": {"value": 260},
                "y": {"value": 30},
                "text": {"value": "Highest Number of Cases"}
            }
        }
    ]
}